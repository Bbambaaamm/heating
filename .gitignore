# Ignoruj všechno
*

# Povol .gitignore
!.gitignore

# Povol VS Code workspace settings (YAML custom tags)
!.vscode/
!.vscode/settings.json

# Povol root YAML soubory
!configuration.yaml
!automations.yaml
!scripts.yaml
!scenes.yaml

# Povol heating (adresář + obsah)
!heating/
!heating/**

# === povol POUZE heating blueprinty ===
!blueprints/
!blueprints/automation/
!blueprints/automation/heating/
!blueprints/automation/heating/**

# === ANALYSIS SNAPSHOT ===
!analysis/
analysis/*
!analysis/entities_snapshot.json

# === shell script pro export entit ===
!scripts/
!scripts/export_entities_to_git.sh


# === ochranné validace a CI ===
!.pre-commit-config.yaml
!.github/
!.github/workflows/
!.github/workflows/**
!README.md
!scripts/run_protective_checks.py
!scripts/validate_yaml_and_ha_style.py
!scripts/validate_debug_guards.py
!scripts/validate_smoke_coverage.py
!scripts/validate_zone_list_consistency.py
!scripts/check_pyyaml_hard_dependency.py
!requirements-test.txt
!tests/
!tests/*.py

# Passive observer source only; runtime observations and checkpoints stay private.
!custom_components/
!custom_components/heating_observer/
!custom_components/heating_observer/*.py
!custom_components/heating_observer/manifest.json
!docs/
!docs/heating-observer.md
!docs/heating-observer-card.yaml
!scripts/replay_heating_observer.py
!scripts/passive_diagnostics/
!scripts/passive_diagnostics/*.py
!scripts/passive_diagnostics/*.jinja
!docs/heating-passive-diagnostics-v2.md
