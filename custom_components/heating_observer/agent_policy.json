{
  "version": "1.0",
  "default_deny": true,
  "principles": {
    "ha_is_authoritative_control_layer": true,
    "agent_runtime_may_control_devices": false,
    "unknown_is_not_safe": true,
    "hypotheses_never_auto_promote_to_fact": true,
    "active_safety_changes_require_human": true
