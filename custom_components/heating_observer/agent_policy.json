    "green": [
      "docs/**",
      "tests/**",
      "agent_platform/**",
      "scripts/replay/**",
      "custom_components/heating_observer/**"
    ],
    "yellow": [
      "heating/observer/**",
      "dashboard/**"
    ],
    "red": [
      "heating/control/**",
      "heating/safety/**",
      "automations.yaml",
      "scripts.yaml"
    ]
